{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["//#dev:postgres"],
      "persistent": true
    },
    "//#dev:postgres": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "passThroughEnv": ["KEVA_TEST_DATABASE_URL"]
    },
    "@keva/server#test": {
      "dependsOn": ["^build", "@keva/core#test"],
      "outputs": ["coverage/**"],
      "passThroughEnv": ["KEVA_TEST_DATABASE_URL"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
