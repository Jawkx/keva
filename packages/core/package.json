{
  "name": "@keva/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "default": "./dist/postgres/index.js"
    },
    "./s3": {
      "types": "./dist/s3.d.ts",
      "default": "./dist/s3.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run src",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs scripts/migrate.ts",
    "db:migrate:staging": "node --env-file=.env.staging node_modules/tsx/dist/cli.mjs scripts/migrate.ts",
    "db:migrate:prod": "node --env-file=.env.production node_modules/tsx/dist/cli.mjs scripts/migrate.ts"
  },
  "dependencies": {
    "@keva/schema": "workspace:*",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "0.45.2",
    "effect": "4.0.0-rc.109",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@keva/effect-test": "workspace:*",
    "@keva/tsconfig": "workspace:*",
    "@types/node": "22.15.30",
    "drizzle-kit": "0.31.10",
    "tsx": "4.22.4",
    "vitest": "4.1.9"
  }
}
