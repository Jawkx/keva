# Per-environment DATABASE_URL for running Drizzle migrations.
#
# Copy this file to one of:
#   .env.staging      -> used by `pnpm db:migrate:staging`
#   .env.production   -> used by `pnpm db:migrate:prod`
# (both are gitignored via .env.*)
#
# Local dev migrations use apps/server/.env instead (`pnpm db:migrate`).
#
# Use the DIRECT host (NOT the `-pooler` one) for migrations, and keep
# sslmode=require. Grab the full string from the Neon Console:
#   keva -> <branch> -> Connect -> toggle "Direct connection" (pooling off).
DATABASE_URL="postgres://<user>:<password>@ep-xxxx.c-2.ap-southeast-1.aws.neon.tech/<db>?sslmode=require"
