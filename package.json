{
  "name": "keva",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:app": "turbo dev --filter=@keva/server --filter=@keva/web --ui=stream",
    "dev:server": "pnpm --filter @keva/server dev",
    "dev:web": "pnpm --filter @keva/web dev",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "turbo lint",
    "db:generate": "pnpm --filter @keva/core db:generate",
    "db:migrate": "pnpm --filter @keva/core db:migrate"
  },
  "devDependencies": {
    "turbo": "2.9.18",
    "typescript": "6.0.3"
  }
}
