{
  "name": "@keva/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "default": "./dist/postgres/index.js"
    },
    "./s3": {
      "types": "./dist/s3.d.ts",
      "default": "./dist/s3.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@keva/schema": "workspace:*",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "0.45.2",
    "effect": "3.21.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@keva/tsconfig": "workspace:*",
    "drizzle-kit": "0.31.10",
    "vitest": "4.1.9"
  }
}
