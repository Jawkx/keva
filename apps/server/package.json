{
  "name": "@keva/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm --filter @keva/core build && node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs watch src/node.ts",
    "dev:raw": "pnpm --filter @keva/core build && tsx watch src/node.ts",
    "start": "node dist/node.js",
    "jobs": "tsx src/jobs.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run src",
    "lint": "tsc -p tsconfig.json --noEmit",
    "auth:generate": "auth generate --config src/better-auth-cli.ts --output src/auth-schema.ts --yes"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.22",
    "@cloudflare/containers": "0.3.7",
    "@hono/node-server": "2.0.5",
    "@keva/core": "workspace:*",
    "@keva/mcp": "workspace:*",
    "@keva/schema": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@polar-sh/better-auth": "1.8.4",
    "@polar-sh/sdk": "0.49.0",
    "better-auth": "1.6.22",
    "drizzle-orm": "0.45.2",
    "effect": "3.21.4",
    "hono": "4.12.26",
    "postgres": "3.4.9",
    "resend": "6.17.2"
  },
  "devDependencies": {
    "@keva/effect-test": "workspace:*",
    "@keva/tsconfig": "workspace:*",
    "@types/node": "22.15.30",
    "auth": "1.6.22",
    "tsx": "4.22.4",
    "vitest": "4.1.9"
  }
}
