KEVA_STATIC_TOKEN=replace-with-a-long-random-secret
KEVA_TENANT_ID=local
PORT=8787

# Enable durable metadata:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/keva

# Enable S3-compatible blobs:
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_BUCKET=keva
# S3_FORCE_PATH_STYLE=true

# Phase 4 Better Auth (web login). Needs DATABASE_URL set too.
# BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# BETTER_AUTH_URL=http://127.0.0.1:8787

# Web dev stack (serving apps/web behind its Vite proxy):
#  - Emit relative loopback blob URLs so uploads flow through the proxy:
# KEVA_LOOPBACK_BASE_URL=
#  - Origins Better Auth trusts for login (defaults already cover the Vite dev
#    server at :5173; override in production):
# KEVA_TRUSTED_ORIGINS=http://localhost:5173
