{
  "name": "keva",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:app": "turbo dev --filter=@keva/server --filter=@keva/web --ui=stream",
    "dev:server": "pnpm --filter @keva/server dev",
    "dev:web": "pnpm --filter @keva/web dev",
    "polar:listen": "polar listen http://localhost:8787/api/auth/polar/webhooks",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "turbo lint && pnpm lint:ox && pnpm lint:no-direct-use-effect",
    "lint:fix": "oxlint --fix .",
    "lint:ox": "oxlint --deny-warnings .",
    "lint:no-direct-use-effect": "node scripts/check-no-direct-use-effect.mjs",
    "format": "oxfmt apps packages tooling scripts package.json pnpm-workspace.yaml turbo.json",
    "format:check": "oxfmt --check apps packages tooling scripts package.json pnpm-workspace.yaml turbo.json",
    "db:generate": "pnpm --filter @keva/core db:generate",
    "db:migrate": "pnpm --filter @keva/core db:migrate",
    "doctor": "npx react-doctor@latest"
  },
  "devDependencies": {
    "oxfmt": "0.56.0",
    "oxlint": "1.71.0",
    "react-doctor": "^0.7.2",
    "turbo": "2.9.18",
    "typescript": "7.0.2",
    "wrangler": "4.107.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.8.0"
}
