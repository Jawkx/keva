KEVA_STATIC_TOKEN=replace-with-a-long-random-secret
KEVA_TENANT_ID=local
KEVA_ENVIRONMENT=development
KEVA_BASE_URL=http://localhost:5173

# Wrangler's local Hyperdrive binding connects to this database.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://postgres:postgres@localhost:5432/keva

# The Cloudflare Container receives this direct database URL.
MEDIA_DATABASE_URL=postgres://postgres:postgres@host.docker.internal:5432/keva

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=keva
S3_FORCE_PATH_STYLE=true

# Better Auth web login.
# BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# BETTER_AUTH_URL=http://localhost:5173

# Email verification is required only when KEVA_ENVIRONMENT=production.
# RESEND_API_KEY=re_...
# RESEND_FROM=Keva <accounts@usekeva.com>

# Web origins Better Auth trusts.
# KEVA_TRUSTED_ORIGINS=http://localhost:5173

# Google OAuth. Use this authorized redirect URI locally:
# http://localhost:5173/api/auth/callback/google
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...

# Polar subscriptions. Use a separate sandbox access token locally.
# POLAR_SERVER=sandbox
# POLAR_ACCESS_TOKEN=polar_oat_...
# POLAR_WEBHOOK_SECRET=polar_whs_...
# POLAR_PRODUCT_100GB_ID=40b01c2d-f8ff-4d11-a41e-32a63c15d612
# POLAR_PRODUCT_500GB_ID=b1422267-bf7f-427a-b0ea-8fc7d9db5a00
# POLAR_PRODUCT_1TB_ID=46f14277-b2bd-4b35-ba97-b4bb4cfab7dc
# POLAR_PRODUCT_2TB_ID=b3e06bed-0b77-431b-9244-bc17a6f5b12b

# Database-backed tests use a separate database.
# KEVA_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/keva_test

# Vite development proxy target.
# VITE_API_TARGET=http://127.0.0.1:8787
