{
  "name": "keva",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "turbo lint",
    "db:generate": "pnpm --filter @keva/core db:generate",
    "db:migrate": "pnpm --filter @keva/core db:migrate"
  },
  "devDependencies": {
    "turbo": "2.9.18",
    "typescript": "6.0.3"
  }
}
