KEVA_STATIC_TOKEN=replace-with-a-long-random-secret
KEVA_TENANT_ID=local
PORT=8787

# Postgres metadata and S3-compatible blob storage are required.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/keva

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=keva
S3_FORCE_PATH_STYLE=true

# Phase 4 Better Auth (web login). Needs DATABASE_URL set too.
# BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Public browser origin. Keep the localhost hostname exact so OAuth cookies and
# redirects stay on the Vite app rather than the API-only port.
# BETTER_AUTH_URL=http://localhost:5173

# Production-only email verification. RESEND_API_KEY and RESEND_FROM are
# required when KEVA_ENVIRONMENT=production and are ignored otherwise.
# KEVA_ENVIRONMENT=production
# RESEND_API_KEY=re_...
# RESEND_FROM=Keva <accounts@usekeva.com>

# Web dev stack: origins Better Auth trusts for login (defaults already cover
# the Vite dev server at :5173; override in production):
# KEVA_TRUSTED_ORIGINS=http://localhost:5173

# Google OAuth. Create a non-production Web application client with
# http://localhost:5173/api/auth/callback/google as an authorized redirect URI.
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...

# Polar subscriptions. Use a separate sandbox access token for local development.
# Run `pnpm polar:listen`, select Sandbox, and use its generated webhook secret.
# POLAR_SERVER=sandbox
# POLAR_ACCESS_TOKEN=polar_oat_...
# POLAR_WEBHOOK_SECRET=polar_whs_...
# POLAR_PRODUCT_100GB_ID=40b01c2d-f8ff-4d11-a41e-32a63c15d612
# POLAR_PRODUCT_500GB_ID=b1422267-bf7f-427a-b0ea-8fc7d9db5a00
# POLAR_PRODUCT_1TB_ID=46f14277-b2bd-4b35-ba97-b4bb4cfab7dc
# POLAR_PRODUCT_2TB_ID=b3e06bed-0b77-431b-9244-bc17a6f5b12b

# Database-backed tests. The test database must be separate from DATABASE_URL.
# KEVA_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/keva_test

# Vite development proxy target for apps/web.
# VITE_API_TARGET=http://127.0.0.1:8787
